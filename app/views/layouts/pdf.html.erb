<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    @page {
      margin: 20mm;
    }

    body {
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-size: 12px;
      line-height: 1.6;
      color: #333;
      margin: 0;
      padding: 0;
    }

    .pdf-header {
      text-align: center;
      padding-bottom: 20px;
      margin-bottom: 25px;
      border-bottom: 3px solid #1351AA;
    }

    .pdf-brand {
      font-size: 14px;
      font-weight: 700;
      color: #1351AA;
      letter-spacing: 1px;
      text-transform: uppercase;
      margin-bottom: 5px;
    }

    .pdf-title {
      font-size: 24px;
      font-weight: 800;
      color: #1351AA;
      margin: 10px 0 5px 0;
    }

    .pdf-subtitle {
      font-size: 11px;
      color: #888;
    }

    .pdf-content h3 {
      font-size: 18px;
      font-weight: 700;
      color: #1351AA;
      margin: 25px 0 10px 0;
      padding-bottom: 6px;
      border-bottom: 2px solid #e0e7f1;
    }

    .pdf-content h3:first-child {
      margin-top: 0;
    }

    .pdf-content h4 {
      font-size: 14px;
      font-weight: 600;
      color: #2a6dbf;
      margin: 18px 0 8px 0;
      padding-left: 10px;
      border-left: 3px solid #2a6dbf;
    }

    .pdf-content p {
      margin: 0 0 10px 0;
      text-align: justify;
    }

    .pdf-content ul, .pdf-content ol {
      margin: 8px 0 14px 0;
      padding-left: 25px;
    }

    .pdf-content li {
      margin-bottom: 6px;
      line-height: 1.5;
    }

    .pdf-content strong {
      color: #1351AA;
      font-weight: 700;
    }

    .pdf-content em {
      color: #555;
      font-style: italic;
    }

    .pdf-footer {
      margin-top: 30px;
      padding-top: 15px;
      border-top: 1px solid #ddd;
      text-align: center;
      font-size: 10px;
      color: #aaa;
    }
  </style>
</head>
<body>
  <%= yield %>
</body>
</html>
