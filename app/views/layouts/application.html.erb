<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} | Studigo" : "Studigo — Transforme tes PDF en flashcards et quiz avec l'IA" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : "Importe un PDF ou un texte. Studigo génère automatiquement des flashcards, quiz et fiches de révision grâce à l'IA. Gratuit pour commencer." %>">
    <meta name="keywords" content="flashcards IA, quiz automatique, révision PDF, étude intelligente, générateur de flashcards, studigo">
    <meta name="author" content="Studigo">
    <meta name="robots" content="index, follow">
    <!-- TODO: mettre à jour og:url et og:image quand le domaine custom sera configuré -->
    <meta property="og:locale" content="fr_FR">
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= content_for?(:title) ? yield(:title) : "Studigo — Transforme tes PDF en flashcards et quiz avec l'IA" %>">
    <meta property="og:description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : "Importe tes cours, l'IA génère tes flashcards et quiz. Révise plus vite, seul ou entre amis." %>">
    <meta property="og:site_name" content="Studigo">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:image" content="<%= asset_url('og-image.png') rescue '' %>"><!-- TODO: créer og-image.png 1200x630 -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for?(:title) ? yield(:title) : "Studigo — Transforme tes PDF en flashcards et quiz avec l'IA" %>">
    <meta name="twitter:description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : "Importe tes cours, l'IA génère tes flashcards et quiz. Révise plus vite, seul ou entre amis." %>">
    <meta name="twitter:image" content="<%= asset_url('og-image.png') rescue '' %>"><!-- TODO: créer og-image.png -->
    <meta name="twitter:site" content="@Armagu3don">
    <link rel="canonical" href="<%= request.original_url %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Studigo",
      "url": "https://studigo.fr",
      "description": "Plateforme d'étude intelligente qui transforme tes PDF en flashcards et quiz grâce à l'IA."
    }
    </script>
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Studigo",
      "applicationCategory": "EducationalApplication",
      "operatingSystem": "Web",
      "description": "Transforme tes PDF en flashcards et quiz avec l'IA. Révise plus vite, seul ou entre amis.",
      "url": "https://studigo.fr",
      "offers": [
        {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "EUR",
          "description": "Plan Gratuit"
        },
        {
          "@type": "Offer",
          "price": "9.99",
          "priceCurrency": "EUR",
          "description": "Plan Pro mensuel"
        }
      ],
      "aggregateRating": null
    }
    </script>
    <!-- TODO: ajouter aggregateRating quand on aura des avis -->
    <!-- TODO: mettre à jour l'URL vers studigo.fr -->
    <%= content_for?(:structured_data) ? yield(:structured_data) : "" %>

    <%# Google Fonts: Space Grotesk (titres) + Inter (UI/body) %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://cdn.jsdelivr.net/npm/animejs@3.2.2/lib/anime.min.js"></script>

    <%# Tarteaucitron - Gestion du consentement cookies (RGPD/CNIL) %>
    <script src="https://cdn.jsdelivr.net/npm/tarteaucitronjs@1.17.0/tarteaucitron.min.js"></script>
    <script>
      tarteaucitron.init({
        "privacyUrl": "<%= privacy_policy_path %>",
        "bodyPosition": "bottom",
        "hashtag": "#tarteaucitron",
        "cookieName": "tarteaucitron",
        "orientation": "bottom",
        "groupServices": false,
        "showDetailsOnClick": true,
        "serviceDefaultState": "wait",
        "showAlertSmall": false,
        "cookieslist": false,
        "closePopup": false,
        "showIcon": true,
        "iconPosition": "BottomRight",
        "adblocker": false,
        "DenyAllCta": true,
        "AcceptAllCta": true,
        "highPrivacy": true,
        "alwaysNeedConsent": false,
        "handleBrowserDNTRequest": false,
        "removeCredit": true,
        "moreInfoLink": true,
        "useExternalCss": false,
        "useExternalJs": false,
        "mandatory": true,
        "mandatoryCta": true,
        "googleConsentMode": true,
        "partnersList": false
      });

      // ================================================
      // SERVICES À ACTIVER QUAND TU EN AURAS BESOIN
      // Décommente les lignes correspondantes
      // ================================================

      // Google Analytics 4
      // tarteaucitron.user.gtagUa = 'G-XXXXXXXXXX';
      // (tarteaucitron.job = tarteaucitron.job || []).push('gtag');

      // Google Analytics Universal (ancien)
      // tarteaucitron.user.analyticsUa = 'UA-XXXXXXXXX-X';
      // (tarteaucitron.job = tarteaucitron.job || []).push('analytics');

      // Facebook Pixel
      // tarteaucitron.user.facebookpixelId = 'XXXXXXXXXX';
      // (tarteaucitron.job = tarteaucitron.job || []).push('facebookpixel');

      // Hotjar
      // tarteaucitron.user.hotjarId = 'XXXXXXX';
      // tarteaucitron.user.hotjarSv = '6';
      // (tarteaucitron.job = tarteaucitron.job || []).push('hotjar');
    </script>
    <!-- Analytics — Plausible (RGPD-friendly, pas de cookies) -->
    <!-- TODO: créer un compte sur plausible.io et remplacer studigo.fr par le bon domaine -->
    <script defer data-domain="studigo.fr" src="https://plausible.io/js/script.js"></script>

    <script>
      (function() {
        var saved = localStorage.getItem('theme');
        // Migration: old code stored 'dark' — clear it so system detection works
        if (saved === 'dark') {
          localStorage.removeItem('theme');
          saved = null;
        }
        // Apply light mode if explicitly saved OR if system prefers light (and no manual override)
        if (saved === 'light' || (!saved && window.matchMedia('(prefers-color-scheme: light)').matches)) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>

  <body class="<%= controller_name %>-<%= action_name %>" data-controller="dark-mode">
    <a href="#main-content" class="skip-to-content">Aller au contenu principal</a>

    <!-- Animated Background -->
    <div class="home-background" aria-hidden="true">
      <div class="floating-icons">
        <!-- Book icon -->
        <div class="floating-icon size-lg icon-1 glow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
          </svg>
        </div>
        <!-- Pen icon -->
        <div class="floating-icon size-md icon-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
            <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
            <path d="M2 2l7.586 7.586"></path>
          </svg>
        </div>
        <!-- Flashcard / Card icon -->
        <div class="floating-icon size-lg icon-3">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="4" width="20" height="16" rx="2"></rect>
            <line x1="6" y1="8" x2="18" y2="8"></line>
            <line x1="6" y1="12" x2="14" y2="12"></line>
          </svg>
        </div>
        <!-- Graduation cap -->
        <div class="floating-icon size-md icon-4 glow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
            <path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"></path>
          </svg>
        </div>
        <!-- Notepad icon -->
        <div class="floating-icon size-sm icon-5">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
        </div>
        <!-- Lightbulb / Idea -->
        <div class="floating-icon size-md icon-6">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M9 18h6"></path>
            <path d="M10 22h4"></path>
            <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"></path>
          </svg>
        </div>
        <!-- Pencil -->
        <div class="floating-icon size-lg icon-7 glow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
          </svg>
        </div>
        <!-- Open book -->
        <div class="floating-icon size-sm icon-8">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
            <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
          </svg>
        </div>
        <!-- Bookmark -->
        <div class="floating-icon size-md icon-9">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
          </svg>
        </div>
        <!-- Brain / Learning -->
        <div class="floating-icon size-lg icon-10">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M12 2a4 4 0 0 0-4 4v1a3 3 0 0 0-3 3v1a3 3 0 0 0 0 6v1a3 3 0 0 0 3 3v1a4 4 0 0 0 8 0v-1a3 3 0 0 0 3-3v-1a3 3 0 0 0 0-6v-1a3 3 0 0 0-3-3V6a4 4 0 0 0-4-4z"></path>
          </svg>
        </div>
        <!-- Clock / Study time -->
        <div class="floating-icon size-sm icon-11 glow">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
        </div>
        <!-- Star / Achievement -->
        <div class="floating-icon size-md icon-12">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
        </div>
      </div>
    </div>

    <%= render "shared/navbar" %>
    <%= render "shared/usage_banner" %>
    <div aria-live="polite" aria-atomic="true">
      <%= render "shared/flashes" %>
    </div>

    <main id="main-content">
      <%= render "shared/breadcrumbs" %>
      <%= yield %>
    </main>

    <%= render "shared/footer" %>
  </body>
</html>
