<%= turbo_stream.prepend "notes-list" do %>
  <%= turbo_frame_tag dom_id(@note) do %>
    <div class="note-item <%= @note.annotation_type == 'inline' ? 'annotation-item' : '' %>">
      <% if @note.annotation_type == "inline" && @note.selected_text.present? %>
        <div class="note-item-quote">"<%= truncate(@note.selected_text, length: 60) %>"</div>
      <% end %>
      <div class="note-item-content"><%= @note.content %></div>
      <%= button_to note_path(@note), method: :delete, data: { turbo_confirm: "Supprimer cette note ?" }, class: "btn-delete-note-item" do %>
        <i class="fas fa-times"></i>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if @note.annotation_type == "sidebar" || @note.annotation_type.nil? %>
  <%= turbo_stream.replace "newNoteForm" do %>
    <div class="collapse" id="newNoteForm">
      <div class="new-note-form-container">
        <%= form_with url: lecture_notes_path(@note.lecture), method: :post, data: { turbo_stream: true }, class: "new-note-form", id: "sidebar-note-form" do %>
          <input type="hidden" name="note[annotation_type]" value="sidebar">
          <textarea name="note[content]" placeholder="Écris ta note ici..." rows="3" required class="note-textarea"></textarea>
          <div class="new-note-actions">
            <button type="button" class="btn-cancel-note" data-bs-toggle="collapse" data-bs-target="#newNoteForm">Annuler</button>
            <button type="submit" class="btn-save-note">
              <i class="fas fa-check"></i> Enregistrer
            </button>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
