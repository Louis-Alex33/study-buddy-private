<!-- Animated Study Background -->
<div class="home-background">
  <div class="floating-icons">
    <!-- Book icon -->
    <div class="floating-icon size-lg icon-1 glow">
      <svg viewBox="0 0 24 24">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
      </svg>
    </div>
    <!-- Pen icon -->
    <div class="floating-icon size-md icon-2">
      <svg viewBox="0 0 24 24">
        <path d="M12 19l7-7 3 3-7 7-3-3z"></path>
        <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path>
        <path d="M2 2l7.586 7.586"></path>
      </svg>
    </div>
    <!-- Flashcard / Card icon -->
    <div class="floating-icon size-lg icon-3">
      <svg viewBox="0 0 24 24">
        <rect x="2" y="4" width="20" height="16" rx="2"></rect>
        <line x1="6" y1="8" x2="18" y2="8"></line>
        <line x1="6" y1="12" x2="14" y2="12"></line>
      </svg>
    </div>
    <!-- Graduation cap -->
    <div class="floating-icon size-md icon-4 glow">
      <svg viewBox="0 0 24 24">
        <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
        <path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"></path>
      </svg>
    </div>
    <!-- Notepad icon -->
    <div class="floating-icon size-sm icon-5">
      <svg viewBox="0 0 24 24">
        <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"></path>
        <polyline points="14 2 14 8 20 8"></polyline>
        <line x1="16" y1="13" x2="8" y2="13"></line>
        <line x1="16" y1="17" x2="8" y2="17"></line>
      </svg>
    </div>
    <!-- Lightbulb / Idea -->
    <div class="floating-icon size-md icon-6">
      <svg viewBox="0 0 24 24">
        <path d="M9 18h6"></path>
        <path d="M10 22h4"></path>
        <path d="M15.09 14c.18-.98.65-1.74 1.41-2.5A4.65 4.65 0 0 0 18 8 6 6 0 0 0 6 8c0 1 .23 2.23 1.5 3.5A4.61 4.61 0 0 1 8.91 14"></path>
      </svg>
    </div>
    <!-- Pencil -->
    <div class="floating-icon size-lg icon-7 glow">
      <svg viewBox="0 0 24 24">
        <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
      </svg>
    </div>
    <!-- Open book -->
    <div class="floating-icon size-sm icon-8">
      <svg viewBox="0 0 24 24">
        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
      </svg>
    </div>
    <!-- Bookmark -->
    <div class="floating-icon size-md icon-9">
      <svg viewBox="0 0 24 24">
        <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
      </svg>
    </div>
    <!-- Brain / Learning -->
    <div class="floating-icon size-lg icon-10">
      <svg viewBox="0 0 24 24">
        <path d="M12 2a4 4 0 0 0-4 4v1a3 3 0 0 0-3 3v1a3 3 0 0 0 0 6v1a3 3 0 0 0 3 3v1a4 4 0 0 0 8 0v-1a3 3 0 0 0 3-3v-1a3 3 0 0 0 0-6v-1a3 3 0 0 0-3-3V6a4 4 0 0 0-4-4z"></path>
      </svg>
    </div>
    <!-- Clock / Study time -->
    <div class="floating-icon size-sm icon-11 glow">
      <svg viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10"></circle>
        <polyline points="12 6 12 12 16 14"></polyline>
      </svg>
    </div>
    <!-- Star / Achievement -->
    <div class="floating-icon size-md icon-12">
      <svg viewBox="0 0 24 24">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
      </svg>
    </div>
  </div>
</div>

<!-- Main Content -->
<div class="home-content">

  <% if user_signed_in? %>
    <%# ========== DASHBOARD CONNECTE ========== %>
    <div class="hero-section">
      <p class="hero-tagline">Ton espace d'apprentissage</p>
      <h1 class="hero-title">Bienvenue sur <span class="hero-highlight" data-controller="text-animation">Studigo</span></h1>
      <p class="hero-subtitle">
        Importe tes cours, et laisse l'IA faire le reste.<br>
        Flashcards, quiz, assistant personnel — tout est <strong>automatisé</strong>.
      </p>
      <button type="button" class="btn btn-upload-document" data-bs-toggle="modal" data-bs-target="#uploadModal">
        <i class="fas fa-cloud-upload-alt"></i> Télécharger un document
      </button>
    </div>

    <!-- Categories Section -->
    <div class="categories-section">
      <div class="categories-section-header">
        <h3 class="section-title">Mes catégories</h3>
        <button type="button" class="btn-add-category" data-bs-toggle="modal" data-bs-target="#newCategoryModal">
          <i class="fas fa-plus"></i> Nouvelle catégorie
        </button>
      </div>
      <% if @categories&.any? %>
        <div class="categories-grid">
          <% @categories.each do |category| %>
            <div class="category-card-wrapper">
              <%= link_to lectures_path(query: category.title), class: "category-card-link" do %>
                <div class="category-card">
                  <div class="category-card-icon">
                    <i class="fas fa-folder"></i>
                  </div>
                  <div class="category-card-content">
                    <h5 class="category-card-title"><%= category.title %></h5>
                    <div class="category-card-stats">
                      <span class="category-stat"><i class="fas fa-book"></i> <%= category.lectures.count %></span>
                      <span class="category-stat"><i class="fas fa-question-circle"></i> <%= category.quizzes.count %></span>
                      <span class="category-stat"><i class="fas fa-clone"></i> <%= category.lectures.sum { |l| l.flashcards.size } %></span>
                    </div>
                  </div>
                </div>
              <% end %>
              <% if category.lectures.empty? && category.quizzes.empty? %>
                <%= button_to category_path(category), method: :delete, class: "btn-delete-category", data: { turbo_confirm: "Supprimer la catégorie « #{category.title} » ?" } do %>
                  <i class="fas fa-times"></i>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      <% else %>
        <div class="empty-state">
          <div class="empty-state-icon">
            <span style="font-size: 2.5rem;">📁</span>
          </div>
          <p class="empty-state-text">
            Aucune catégorie pour le moment.<br>Crée ta première catégorie pour commencer à organiser tes cours !
          </p>
        </div>
      <% end %>
    </div>

  <% else %>
    <%# ========== LANDING PAGE VISITEUR ========== %>

    <!-- HERO -->
    <div class="hero-section hero-section-landing">
      <div class="hero-content">
        <p class="hero-tagline">Finis les heures perdues à faire des fiches. L'IA s'en charge.</p>
        <h1 class="hero-title">Transforme tes cours en <span class="hero-highlight" data-controller="text-animation">1 minute</span></h1>
        <p class="hero-subtitle">
          Importe un PDF ou un texte. Studigo génère automatiquement<br>
          des supports de révision + un <strong>assistant IA</strong> personnel.
        </p>
        <div class="hero-cta-group">
          <%= link_to new_user_registration_path, class: "btn btn-upload-document" do %>
            Importe ton premier cours — c'est gratuit
          <% end %>
          <a href="#how-it-works" class="btn btn-secondary-cta">
            Voir comment ça marche <i class="fas fa-arrow-down"></i>
          </a>
        </div>
        <p class="hero-proof">Version bêta — Rejoins les premiers utilisateurs.</p>
      </div>
      <div class="hero-visual">
        <!-- TODO: remplacer par une vraie capture d'écran du produit -->
        <div class="hero-visual-placeholder">
          <div class="hero-visual-mockup">
            <div class="hero-mockup-header">
              <span class="hero-mockup-dot"></span>
              <span class="hero-mockup-dot"></span>
              <span class="hero-mockup-dot"></span>
            </div>
            <div class="hero-mockup-body">
              <div class="hero-mockup-sidebar">
                <div class="hero-mockup-line short"></div>
                <div class="hero-mockup-line"></div>
                <div class="hero-mockup-line medium"></div>
              </div>
              <div class="hero-mockup-main">
                <div class="hero-mockup-line"></div>
                <div class="hero-mockup-line medium"></div>
                <div class="hero-mockup-line short"></div>
                <div class="hero-mockup-cards">
                  <div class="hero-mockup-card"></div>
                  <div class="hero-mockup-card"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- SOCIAL PROOF -->
    <!-- TODO: remplacer par des stats dynamiques -->
    <section class="landing-section landing-social-proof">
      <div class="landing-section-inner">
        <div class="social-proof-grid">
          <div class="social-proof-item">
            <span class="social-proof-number">100+</span>
            <span class="social-proof-label">Flashcards générées</span>
          </div>
          <div class="social-proof-item">
            <span class="social-proof-number">50+</span>
            <span class="social-proof-label">Utilisateurs en bêta</span>
          </div>
          <div class="social-proof-item">
            <span class="social-proof-number">30s</span>
            <span class="social-proof-label">Pour générer un quiz</span>
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how-it-works" class="landing-section">
      <div class="landing-section-inner">
        <h2 class="landing-section-title">Comment ça marche ?</h2>
        <p class="landing-section-subtitle">3 étapes. Aucune configuration. Résultats immédiats.</p>
        <div class="steps-grid">
          <div class="step-card">
            <div class="step-number">1</div>
            <div class="step-emoji">📄</div>
            <h3>Importe</h3>
            <p>Glisse ton PDF, image ou texte. L'IA analyse et structure le contenu automatiquement.</p>
          </div>
          <div class="step-card">
            <div class="step-number">2</div>
            <div class="step-emoji">⚡</div>
            <h3>Génère</h3>
            <p>Flashcards, quiz et fiches de révision sont créés en quelques secondes par l'IA.</p>
          </div>
          <div class="step-card">
            <div class="step-number">3</div>
            <div class="step-emoji">🎯</div>
            <h3>Révise</h3>
            <p>Teste-toi avec les flashcards et quiz. Défie tes amis en mode multijoueur.</p>
          </div>
        </div>
        <div class="landing-section-cta">
          <%= link_to new_user_registration_path, class: "btn btn-upload-document" do %>
            Essayer gratuitement
          <% end %>
        </div>
      </div>
    </section>

    <!-- POUR QUI -->
    <section class="landing-section">
      <div class="landing-section-inner">
        <h2 class="landing-section-title">Studigo s'adapte à toi</h2>
        <p class="landing-section-subtitle">Que tu sois au lycée ou en master, Studigo t'aide à réviser plus efficacement.</p>
        <div class="audience-grid">
          <div class="audience-card">
            <div class="audience-icon">🎓</div>
            <h3>Lycéens</h3>
            <p>Prépare ton bac avec des flashcards générées depuis tes cours.</p>
          </div>
          <div class="audience-card">
            <div class="audience-icon">🏥</div>
            <h3>Étudiants en médecine</h3>
            <p>Mémorise des centaines de notions sans y passer la nuit.</p>
          </div>
          <div class="audience-card">
            <div class="audience-icon">📐</div>
            <h3>Prépa & BTS</h3>
            <p>Transforme tes polys en quiz pour des révisions actives.</p>
          </div>
          <div class="audience-card">
            <div class="audience-icon">🌍</div>
            <h3>Formation pro & concours</h3>
            <p>Révise n'importe quel contenu, à ton rythme.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- PRODUCT PREVIEW -->
    <section id="preview" class="landing-section">
      <div class="landing-section-inner">
        <h2 class="landing-section-title">Aperçu du produit</h2>
        <p class="landing-section-subtitle">De tes PDF à la révision, sans prise de tête.</p>
        <div class="preview-grid">
          <!-- Mock Flashcard -->
          <div class="preview-card">
            <div class="preview-card-header">
              <span class="preview-badge">Flashcard</span>
            </div>
            <div class="preview-card-body">
              <div class="mock-flashcard">
                <div class="mock-flashcard-question">
                  <span class="mock-label">Question</span>
                  <p>Quelle est la capitale de la France ?</p>
                </div>
                <div class="mock-flashcard-divider"></div>
                <div class="mock-flashcard-answer">
                  <span class="mock-label">Réponse</span>
                  <p>Paris</p>
                </div>
              </div>
              <p class="preview-caption">Flashcards générées automatiquement à partir de ton cours.</p>
            </div>
          </div>

          <!-- Mock Quiz -->
          <div class="preview-card">
            <div class="preview-card-header">
              <span class="preview-badge">Quiz</span>
            </div>
            <div class="preview-card-body">
              <div class="mock-quiz">
                <p class="mock-quiz-question">Quel est le plus grand océan du monde ?</p>
                <div class="mock-quiz-options">
                  <div class="mock-option">Atlantique</div>
                  <div class="mock-option mock-option-correct">Pacifique</div>
                  <div class="mock-option">Indien</div>
                  <div class="mock-option">Arctique</div>
                </div>
              </div>
              <p class="preview-caption">Quiz interactifs pour tester tes connaissances.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section id="features" class="landing-section">
      <div class="landing-section-inner">
        <h2 class="landing-section-title">Tout ce qu'il te faut pour réviser</h2>
        <p class="landing-section-subtitle">De tes PDF à la révision, tout est automatisé.</p>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon">🃏</div>
            <h3>Flashcards intelligentes</h3>
            <p>Générées par l'IA à partir de tes cours. Questions pertinentes, mémorisation optimisée.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">📝</div>
            <h3>Quiz automatiques</h3>
            <p>Des quiz créés en un clic pour tester tes connaissances, seul ou entre amis.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">🤖</div>
            <h3>Assistant IA personnel</h3>
            <p>Pose tes questions sur chaque cours. L'IA t'explique les concepts difficiles.</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon">📂</div>
            <h3>Organisation claire</h3>
            <p>Catégories, notes, documents — tout est rangé et accessible en un clic.</p>
          </div>
        </div>
        <div class="landing-section-cta">
          <%= link_to new_user_registration_path, class: "btn btn-upload-document" do %>
            Créer mon compte
          <% end %>
        </div>
      </div>
    </section>

    <!-- MULTIPLAYER -->
    <section class="landing-section">
      <div class="landing-section-inner">
        <h2 class="landing-section-title">Révise avec tes amis</h2>
        <p class="landing-section-subtitle">Le mode multijoueur de Studigo transforme les révisions en défi. Crée une session, invite tes amis et comparez vos scores en temps réel.</p>
        <div class="multiplayer-steps">
          <div class="multiplayer-step">
            <div class="multiplayer-step-icon">🔗</div>
            <h3>Crée une session</h3>
            <p>Génère un lien de partie en un clic.</p>
          </div>
          <div class="multiplayer-step">
            <div class="multiplayer-step-icon">👥</div>
            <h3>Invite tes amis</h3>
            <p>Partage le lien, ils rejoignent sans inscription.</p>
          </div>
          <div class="multiplayer-step">
            <div class="multiplayer-step-icon">🏆</div>
            <h3>Compare les scores</h3>
            <p>Classement en temps réel à la fin du quiz.</p>
          </div>
        </div>
        <div class="landing-section-cta">
          <%= link_to new_user_registration_path, class: "btn btn-upload-document" do %>
            Essayer le mode multijoueur
          <% end %>
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section id="landing-pricing" class="landing-section">
      <div class="landing-section-inner">
        <h2 class="landing-section-title">Un plan simple, sans surprise</h2>
        <p class="landing-section-subtitle">Commence gratuitement, passe à Pro quand tu veux.</p>
        <div class="landing-pricing-grid">
          <div class="landing-pricing-card">
            <h3 class="landing-pricing-name">Gratuit</h3>
            <div class="landing-pricing-price">0&euro;<span>/mois</span></div>
            <ul class="landing-pricing-features">
              <li><i class="fas fa-check"></i> 3 cours</li>
              <li><i class="fas fa-check"></i> 2 générations de flashcards</li>
              <li><i class="fas fa-check"></i> 1 génération de quiz</li>
              <li><i class="fas fa-check"></i> 10 messages IA au total</li>
              <li><i class="fas fa-check"></i> 5 Mo par document</li>
            </ul>
            <%= link_to new_user_registration_path, class: "btn btn-landing-pricing-secondary" do %>
              Commencer gratuitement
            <% end %>
          </div>
          <div class="landing-pricing-card landing-pricing-card-pro">
            <span class="landing-pricing-badge">Populaire</span>
            <h3 class="landing-pricing-name">Pro</h3>
            <div class="landing-pricing-price">9,99&euro;<span> TTC/mois</span></div>
            <ul class="landing-pricing-features">
              <li><i class="fas fa-check"></i> Cours illimités</li>
              <li><i class="fas fa-check"></i> Flashcards illimitées</li>
              <li><i class="fas fa-check"></i> Quiz illimités</li>
              <li><i class="fas fa-check"></i> Messages IA illimités</li>
              <li><i class="fas fa-check"></i> Mode multijoueur</li>
              <li><i class="fas fa-check"></i> 10 Mo par document</li>
            </ul>
            <p class="landing-pricing-annual"><s>119&euro;</s> <strong>95&euro; TTC/an</strong> (soit 7,92&euro;/mois)</p>
            <%= link_to pricing_path, class: "btn btn-upload-document btn-landing-pricing-primary" do %>
              Passer à Pro
            <% end %>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="landing-section">
      <div class="landing-section-inner">
        <h2 class="landing-section-title">Questions fréquentes</h2>
        <div class="faq-list">
          <details class="faq-item">
            <summary>C'est vraiment gratuit ?</summary>
            <p>Oui. Le plan gratuit inclut : <strong>3 cours</strong>, <strong>10 messages IA</strong> au total, <strong>2 générations de flashcards</strong>, <strong>1 génération de quiz</strong> et <strong>5 Mo</strong> par document. Pour un usage illimité, passe à Studigo Pro.</p>
          </details>
          <details class="faq-item">
            <summary>Quels formats de fichiers sont supportés ?</summary>
            <p>Studigo accepte les <strong>PDF</strong> et les <strong>images</strong> (JPG, PNG). Tu peux aussi coller directement du texte. D'autres formats arrivent bientôt (PowerPoint, Word, etc.).</p>
          </details>
          <details class="faq-item">
            <summary>Mes données sont-elles sécurisées ?</summary>
            <p>Tes documents sont stockés sur AWS S3 et ne sont jamais partagés. Nous utilisons le chiffrement en transit et au repos.</p>
          </details>
          <details class="faq-item">
            <summary>Combien coûte Studigo Pro ?</summary>
            <p>Studigo Pro est à <strong>9,99 € TTC/mois</strong> ou <strong>95 € TTC/an</strong> (soit 7,92 €/mois). Cours illimités, messages IA illimités, générations illimitées et mode multijoueur inclus.</p>
          </details>
          <details class="faq-item">
            <summary>Je peux utiliser Studigo sur mobile ?</summary>
            <p>Oui, Studigo est entièrement responsive et fonctionne sur téléphone, tablette et ordinateur.</p>
          </details>
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="landing-section landing-final-cta">
      <div class="landing-section-inner">
        <h2 class="landing-section-title">Prêt à étudier plus intelligemment ?</h2>
        <p class="landing-section-subtitle">Crée ton compte en 30 secondes. C'est gratuit, sans carte bancaire.</p>
        <%= link_to new_user_registration_path, class: "btn btn-upload-document" do %>
          Créer un compte gratuitement
        <% end %>
      </div>
    </section>

  <% end %>
</div>

<% if user_signed_in? %>
  <!-- Modal pour uploader un document -->
  <div class="modal fade" id="uploadModal" tabindex="-1" aria-labelledby="uploadModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header modal-header-gradient">
          <div>
            <h5 class="modal-title">📄 Télécharger un document</h5>
            <p class="modal-subtitle">Importe un fichier et laisse l'IA générer ta fiche de cours</p>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <%= render "lectures/form", lecture: @lecture %>
      </div>
    </div>
  </div>

  <!-- Modal pour créer une catégorie -->
  <div class="modal fade" id="newCategoryModal" tabindex="-1" aria-labelledby="newCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content">
        <div class="modal-header modal-header-gradient">
          <div>
            <h5 class="modal-title">📚 Nouvelle catégorie</h5>
            <p class="modal-subtitle">Organise tes cours par matière pour y voir plus clair</p>
          </div>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <%= form_with url: categories_path, method: :post, local: true do |f| %>
          <div class="modal-body modal-body-padded">
            <div class="form-group-modal">
              <label class="form-label" for="category_title">Nom de la catégorie</label>
              <input type="text" name="category[title]" id="category_title" class="form-control" placeholder="Ex: Mathématiques" required>
            </div>
          </div>
          <div class="modal-footer modal-footer-centered">
            <button type="button" data-bs-dismiss="modal" class="btn-cancel">Annuler</button>
            <button type="submit" class="btn-submit">Créer</button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
