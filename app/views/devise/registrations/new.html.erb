<div class="auth-page">
  <div class="auth-container">
    <!-- Left panel — branding -->
    <div class="auth-panel-left">
      <div class="auth-brand">
        <div class="auth-brand-logo">S</div>
        <h2 class="auth-brand-name">Studigo</h2>
      </div>
      <h1 class="auth-panel-title">Commencez à apprendre autrement.</h1>
      <p class="auth-panel-desc">Créez votre compte gratuitement et accédez à tous vos outils d'étude.</p>

      <div class="auth-panel-cta">
        <p class="auth-panel-cta-label">Déjà un compte ?</p>
        <%= link_to new_session_path(resource_name), class: "auth-panel-cta-btn" do %>
          <i class="fas fa-sign-in-alt"></i>
          <span>Se connecter</span>
        <% end %>
      </div>
    </div>

    <!-- Right panel — form -->
    <div class="auth-panel-right">
      <div class="auth-form-header">
        <h2 class="auth-form-title">Inscription</h2>
        <p class="auth-form-subtitle">Créez votre compte gratuitement</p>
      </div>

      <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "auth-form" }) do |f| %>
        <%= f.error_notification message: "Veuillez corriger les erreurs suivantes :" %>

        <div class="auth-form-inputs">
          <div class="auth-field">
            <label>E-mail</label>
            <div class="auth-input-icon-wrap">
              <i class="fas fa-envelope"></i>
              <%= f.input :email,
                          required: true,
                          autofocus: true,
                          label: false,
                          placeholder: "votre@email.com",
                          input_html: { autocomplete: "email", class: "auth-input auth-input-with-icon" },
                          wrapper_html: { class: "auth-input-wrapper" } %>
            </div>
          </div>
          <div class="auth-field">
            <label>Mot de passe</label>
            <div class="auth-input-icon-wrap">
              <i class="fas fa-lock"></i>
              <%= f.input :password,
                          required: true,
                          label: false,
                          placeholder: "Minimum #{@minimum_password_length} caractères",
                          hint: false,
                          input_html: { autocomplete: "new-password", class: "auth-input auth-input-with-icon" },
                          wrapper_html: { class: "auth-input-wrapper" } %>
            </div>
          </div>
          <div class="auth-field">
            <label>Confirmation</label>
            <div class="auth-input-icon-wrap">
              <i class="fas fa-check-double"></i>
              <%= f.input :password_confirmation,
                          required: true,
                          label: false,
                          placeholder: "Retapez votre mot de passe",
                          input_html: { autocomplete: "new-password", class: "auth-input auth-input-with-icon" },
                          wrapper_html: { class: "auth-input-wrapper" } %>
            </div>
          </div>
        </div>

        <p class="auth-legal-notice">
          En créant un compte, vous acceptez nos
          <%= link_to "CGU", terms_path %> et notre
          <%= link_to "Politique de confidentialité", privacy_policy_path %>.
        </p>

        <div class="auth-actions">
          <%= f.button :submit, class: "auth-btn-submit" do %>
            <span>Créer mon compte</span>
            <i class="fas fa-arrow-right"></i>
          <% end %>
        </div>
      <% end %>

      <div class="auth-footer">
        <span>Déjà un compte ?</span>
        <%= link_to "Se connecter", new_session_path(resource_name), class: "auth-footer-link" %>
      </div>
    </div>
  </div>
</div>
