<div class="auth-page">
  <div class="auth-card-single">
    <div class="auth-form-header">
      <div class="auth-brand-logo auth-brand-logo-sm">S</div>
      <h2 class="auth-form-title">Mot de passe oublié</h2>
      <p class="auth-form-subtitle">Recevez un lien de réinitialisation par e-mail</p>
    </div>

    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "auth-form" }) do |f| %>
      <%= f.error_notification message: "Veuillez corriger les erreurs suivantes :" %>

      <div class="auth-form-inputs">
        <div class="auth-field">
          <label>E-mail</label>
          <div class="auth-input-icon-wrap">
            <i class="fas fa-envelope"></i>
            <%= f.input :email,
                        required: true,
                        autofocus: true,
                        label: false,
                        placeholder: "votre@email.com",
                        input_html: { autocomplete: "email", class: "auth-input auth-input-with-icon" },
                        wrapper_html: { class: "auth-input-wrapper" } %>
          </div>
        </div>
      </div>

      <div class="auth-actions">
        <%= f.button :submit, class: "auth-btn-submit" do %>
          <span>Envoyer le lien</span>
          <i class="fas fa-paper-plane"></i>
        <% end %>
      </div>
    <% end %>

    <div class="auth-footer">
      <%= link_to "← Retour à la connexion", new_session_path(resource_name), class: "auth-footer-link" %>
    </div>
  </div>
</div>
