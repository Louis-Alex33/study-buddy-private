<div class="auth-page">
  <div class="auth-card-single">
    <div class="auth-form-header">
      <div class="auth-brand-logo auth-brand-logo-sm">S</div>
      <h2 class="auth-form-title">Nouveau mot de passe</h2>
      <p class="auth-form-subtitle">Choisis ton nouveau mot de passe</p>
    </div>

    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "auth-form" }) do |f| %>
      <%= f.error_notification message: "Corrige les erreurs suivantes :" %>
      <%= f.input :reset_password_token, as: :hidden %>
      <%= f.full_error :reset_password_token %>

      <div class="auth-form-inputs">
        <div class="auth-field">
          <label>Nouveau mot de passe</label>
          <div class="auth-input-icon-wrap">
            <i class="fas fa-lock"></i>
            <%= f.input :password,
                        required: true,
                        autofocus: true,
                        label: false,
                        placeholder: "Minimum #{@minimum_password_length} caractères",
                        hint: false,
                        input_html: { autocomplete: "new-password", class: "auth-input auth-input-with-icon" },
                        wrapper_html: { class: "auth-input-wrapper" } %>
          </div>
        </div>
        <div class="auth-field">
          <label>Confirmation</label>
          <div class="auth-input-icon-wrap">
            <i class="fas fa-check-double"></i>
            <%= f.input :password_confirmation,
                        required: true,
                        label: false,
                        placeholder: "Retape ton mot de passe",
                        input_html: { autocomplete: "new-password", class: "auth-input auth-input-with-icon" },
                        wrapper_html: { class: "auth-input-wrapper" } %>
          </div>
        </div>
      </div>

      <div class="auth-actions">
        <%= f.button :submit, class: "auth-btn-submit" do %>
          <span>Mettre à jour</span>
          <i class="fas fa-check"></i>
        <% end %>
      </div>
    <% end %>

    <div class="auth-footer">
      <%= link_to "← Retour à la connexion", new_session_path(resource_name), class: "auth-footer-link" %>
    </div>
  </div>
</div>
