<% content_for(:title, "Mes statistiques") %>

<div class="stats-page">
  <div class="stats-header">
    <div class="stats-header-content">
      <h1><i class="fas fa-chart-bar"></i> Mes statistiques</h1>
      <p>Suivez votre progression et vos accomplissements</p>
    </div>
  </div>

  <!-- Résumé global -->
  <div class="stats-summary-grid">
    <div class="stats-summary-card">
      <div class="stats-summary-icon"><i class="fas fa-book"></i></div>
      <div class="stats-summary-value"><%= @total_lectures %></div>
      <div class="stats-summary-label">Cours</div>
    </div>
    <div class="stats-summary-card">
      <div class="stats-summary-icon"><i class="fas fa-clipboard-check"></i></div>
      <div class="stats-summary-value"><%= @total_attempts %></div>
      <div class="stats-summary-label">Quiz complétés</div>
    </div>
    <div class="stats-summary-card">
      <div class="stats-summary-icon"><i class="fas fa-percentage"></i></div>
      <div class="stats-summary-value"><%= @average_score %></div>
      <div class="stats-summary-label">Score moyen</div>
    </div>
    <div class="stats-summary-card">
      <div class="stats-summary-icon"><i class="fas fa-star"></i></div>
      <div class="stats-summary-value"><%= @perfect_scores %></div>
      <div class="stats-summary-label">Scores parfaits</div>
    </div>
    <div class="stats-summary-card">
      <div class="stats-summary-icon"><i class="fas fa-layer-group"></i></div>
      <div class="stats-summary-value"><%= @mastered_flashcards %></div>
      <div class="stats-summary-label">Flashcards maîtrisées</div>
    </div>
    <div class="stats-summary-card">
      <div class="stats-summary-icon"><i class="fas fa-trophy"></i></div>
      <div class="stats-summary-value"><%= @total_points %></div>
      <div class="stats-summary-label">Points</div>
    </div>
  </div>

  <!-- Cours par catégorie -->
  <% if @lectures_by_category.any? %>
    <div class="stats-section">
      <h2><i class="fas fa-folder"></i> Cours par catégorie</h2>
      <div class="stats-categories-grid">
        <% @lectures_by_category.each do |category, count| %>
          <div class="stats-category-card">
            <span class="stats-category-name"><%= category %></span>
            <span class="stats-category-count"><%= count %></span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!-- Activité récente -->
  <div class="stats-section">
    <h2><i class="fas fa-calendar-alt"></i> Activité des 4 dernières semaines</h2>
    <div class="stats-activity-grid">
      <% @weekly_activity.each do |week| %>
        <div class="stats-activity-card">
          <div class="stats-activity-week">Sem. du <%= week[:week] %></div>
          <div class="stats-activity-data">
            <span><i class="fas fa-book"></i> <%= week[:lectures] %> cours</span>
            <span><i class="fas fa-clipboard-check"></i> <%= week[:attempts] %> quiz</span>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Badges -->
  <div class="stats-section">
    <h2><i class="fas fa-medal"></i> Badges (<%= @badges.count %>/<%= @all_badges.count %>)</h2>
    <div class="stats-badges-grid">
      <% @all_badges.each do |badge| %>
        <div class="stats-badge-card <%= @user.has_badge?(badge.name) ? 'earned' : 'locked' %>">
          <div class="stats-badge-icon">
            <i class="fas <%= badge.icon %>"></i>
          </div>
          <div class="stats-badge-name"><%= badge.name %></div>
          <div class="stats-badge-desc"><%= badge.description %></div>
          <% unless @user.has_badge?(badge.name) %>
            <div class="stats-badge-lock"><i class="fas fa-lock"></i></div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <% if @league %>
    <div class="stats-section">
      <h2><i class="fas fa-chess-queen"></i> Ligue</h2>
      <div class="stats-league-card">
        <div class="stats-league-rank" style="color: <%= @league.rank_color %>">
          <%= @league.display_name %>
        </div>
        <div class="stats-league-details">
          <span><%= @league.points %>/<%= @league.points_threshold %> LP</span>
          <span><%= @league.wins %>W / <%= @league.losses %>L</span>
          <span>Win rate: <%= @league.win_rate %>%</span>
        </div>
      </div>
    </div>
  <% end %>

  <div class="stats-back">
    <%= link_to root_path, class: "btn-back-home" do %>
      <i class="fas fa-arrow-left"></i> Retour à l'accueil
    <% end %>
  </div>
</div>
