<div class="pricing-page">
  <div class="container my-5">
    <div class="pricing-header">
      <h1 class="pricing-main-title">Choisis le plan qui te correspond</h1>
      <p class="pricing-subtitle">Débloque tout le potentiel de Studigo — commence gratuitement, évolue à ton rythme.</p>
    </div>

    <div class="pricing-grid">
      <!-- Plan Gratuit -->
      <div class="pricing-card">
        <h3 class="pricing-plan-name">Gratuit</h3>
        <div class="pricing-price">0&euro;<span>/mois</span></div>
        <p class="pricing-plan-desc">Idéal pour découvrir Studigo</p>
        <ul class="pricing-features">
          <li><i class="fas fa-check"></i> 3 cours</li>
          <li><i class="fas fa-check"></i> 10 messages IA au total</li>
          <li><i class="fas fa-check"></i> 2 générations de flashcards</li>
          <li><i class="fas fa-check"></i> 1 génération de quiz</li>
          <li><i class="fas fa-check"></i> 5 Mo par document</li>
          <li class="disabled"><i class="fas fa-times"></i> Mode multijoueur</li>
        </ul>
        <% if user_signed_in? && current_user.free? %>
          <span class="btn-plan-current">Plan actuel</span>
        <% end %>
      </div>

      <!-- Plan Pro Mensuel -->
      <div class="pricing-card pricing-card-pro">
        <span class="pricing-badge">Populaire</span>
        <h3 class="pricing-plan-name">Pro Mensuel</h3>
        <div class="pricing-price">9,99&euro;<span>/mois</span></div>
        <p class="pricing-plan-desc">Pour les étudiants qui veulent performer</p>
        <ul class="pricing-features">
          <li><i class="fas fa-check"></i> Cours illimités</li>
          <li><i class="fas fa-check"></i> Messages IA illimités</li>
          <li><i class="fas fa-check"></i> Générations de flashcards illimitées</li>
          <li><i class="fas fa-check"></i> Générations de quiz illimitées</li>
          <li><i class="fas fa-check"></i> 10 Mo par document</li>
          <li><i class="fas fa-check"></i> Mode multijoueur</li>
        </ul>
        <% if user_signed_in? && current_user.pro? %>
          <%= link_to "Gérer mon abonnement", subscription_manage_path, class: "btn-plan-action" %>
        <% elsif user_signed_in? %>
          <%= button_to "Passer à Pro", subscription_checkout_path, method: :post, class: "btn-plan-action", data: { turbo: false } %>
        <% else %>
          <%= link_to "Commencer", new_user_registration_path, class: "btn-plan-action" %>
        <% end %>
      </div>

      <!-- Plan Pro Annuel -->
      <div class="pricing-card pricing-card-pro">
        <span class="pricing-badge">-21%</span>
        <h3 class="pricing-plan-name">Pro Annuel</h3>
        <div class="pricing-price">95&euro;<span>/an</span></div>
        <p class="pricing-plan-desc">Soit 7,92&euro;/mois — Économise 25&euro;</p>
        <ul class="pricing-features">
          <li><i class="fas fa-check"></i> Tout le plan Pro Mensuel</li>
          <li><i class="fas fa-check"></i> Économie de 21%</li>
          <li><i class="fas fa-check"></i> Accès complet pendant 12 mois</li>
          <li><i class="fas fa-check"></i> Support prioritaire</li>
        </ul>
        <% if user_signed_in? && current_user.pro? %>
          <%= link_to "Gérer mon abonnement", subscription_manage_path, class: "btn-plan-action" %>
        <% elsif user_signed_in? %>
          <%= button_to "Passer à Pro Annuel", subscription_checkout_path(plan: "annual"), method: :post, class: "btn-plan-action", data: { turbo: false } %>
        <% else %>
          <%= link_to "Commencer", new_user_registration_path, class: "btn-plan-action" %>
        <% end %>
      </div>
    </div>

    <div class="pricing-back">
      <%= link_to root_path, class: "btn-back-home" do %>
        <span>&larr;</span>
        <span>Retour à l'accueil</span>
      <% end %>
    </div>
  </div>
</div>
