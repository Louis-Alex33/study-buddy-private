<div class="pricing-page">
  <div class="container my-5">
    <div class="pricing-header">
      <h1 class="pricing-main-title">💎 Choisissez le plan qui vous correspond</h1>
      <p class="pricing-subtitle">Debloquez tout le potentiel de Studigo — commencez gratuitement, evoluez a votre rythme.</p>
    </div>

    <div class="pricing-grid">
      <!-- Plan Gratuit -->
      <div class="pricing-card">
        <h3 class="pricing-plan-name">🆓 Gratuit</h3>
        <div class="pricing-price">0&euro;<span>/mois</span></div>
        <p class="pricing-plan-desc">Ideal pour decouvrir Studigo</p>
        <ul class="pricing-features">
          <li>✅ 3 cours maximum</li>
          <li>✅ 5 Mo par document</li>
          <li>✅ 10 messages IA au total</li>
          <li>✅ 2 generations de flashcards</li>
          <li>✅ 1 creation de quiz</li>
          <li class="disabled">❌ Mode multijoueur</li>
        </ul>
        <% if user_signed_in? && current_user.free? %>
          <span class="btn-plan-current">Plan actuel</span>
        <% end %>
      </div>

      <!-- Plan Pro Mensuel -->
      <div class="pricing-card pricing-card-pro">
        <span class="pricing-badge">Populaire</span>
        <h3 class="pricing-plan-name">⚡ Pro Mensuel</h3>
        <div class="pricing-price">9,99&euro;<span>/mois</span></div>
        <p class="pricing-plan-desc">Pour les etudiants qui veulent performer</p>
        <ul class="pricing-features">
          <li>✅ Cours illimites</li>
          <li>✅ 10 Mo par document</li>
          <li>✅ Acces complet aux fonctionnalites IA</li>
          <li>✅ Flashcards illimitees</li>
          <li>✅ Quiz illimites</li>
          <li>✅ Mode multijoueur complet</li>
        </ul>
        <% if user_signed_in? && current_user.pro? %>
          <%= link_to "Gérer mon abonnement", subscription_manage_path, class: "btn-plan-action" %>
        <% elsif user_signed_in? %>
          <%= button_to "Passer à Pro", subscription_checkout_path, method: :post, class: "btn-plan-action", data: { turbo: false } %>
        <% else %>
          <%= link_to "Commencer", new_user_registration_path, class: "btn-plan-action" %>
        <% end %>
      </div>

      <!-- Plan Pro Annuel -->
      <div class="pricing-card pricing-card-pro">
        <span class="pricing-badge">-33%</span>
        <h3 class="pricing-plan-name">🏆 Pro Annuel</h3>
        <div class="pricing-price">79,99&euro;<span>/an</span></div>
        <p class="pricing-plan-desc">Soit 6,67&euro;/mois — Economisez 40&euro; 🎉</p>
        <ul class="pricing-features">
          <li>✅ Tout le plan Pro Mensuel</li>
          <li>✅ Economie de 33%</li>
          <li>✅ Acces complet pendant 12 mois</li>
          <li>✅ Support prioritaire</li>
        </ul>
        <% if user_signed_in? && current_user.pro? %>
          <%= link_to "Gérer mon abonnement", subscription_manage_path, class: "btn-plan-action" %>
        <% elsif user_signed_in? %>
          <%= button_to "Passer à Pro Annuel", subscription_checkout_path(plan: "annual"), method: :post, class: "btn-plan-action", data: { turbo: false } %>
        <% else %>
          <%= link_to "Commencer", new_user_registration_path, class: "btn-plan-action" %>
        <% end %>
      </div>
    </div>

    <div class="pricing-back">
      <%= link_to root_path, class: "btn-back-home" do %>
        <span>&larr;</span>
        <span>Retour à l'accueil</span>
      <% end %>
    </div>
  </div>
</div>

