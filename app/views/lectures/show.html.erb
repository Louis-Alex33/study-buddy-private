<div class="container my-5">
  <!-- Header Section -->
  <div class="lecture-show-header">
    <div class="lecture-show-header-content">
      <span class="category-badge">
        <%= @lecture.category.title.upcase %>
      </span>
      <h1><%= @lecture.title %></h1>
    </div>
  </div>

  <!-- Resume Section -->
  <% if @lecture.resume.present? %>
    <%
      # Get annotations for this lecture
      inline_annotations = @lecture.notes.where(annotation_type: "inline").where.not(selected_text: nil)
      sidebar_notes = @lecture.notes.where(annotation_type: ["sidebar", nil])
    %>
    <div class="lecture-resume-card" data-controller="text-annotation" data-text-annotation-lecture-id-value="<%= @lecture.id %>">
      <div class="resume-header">
        <div class="resume-icon"><i class="fas fa-file-alt"></i></div>
        <div class="resume-title">
          <h3>Fiche de cours</h3>
          <p>Générée par l'IA <span class="annotation-hint"><i class="fas fa-highlighter"></i> Sélectionne du texte pour annoter</span></p>
        </div>
        <div class="resume-actions">
          <%= link_to download_resume_lecture_path(@lecture), class: "btn-download-resume" do %>
            <i class="fas fa-file-pdf"></i> Télécharger en PDF
          <% end %>
          <%= button_to re_analyze_lecture_path(@lecture), method: :post, class: "btn-reanalyze-resume", data: { turbo: false, turbo_confirm: "Ré-analyser ce document ? La fiche actuelle sera remplacée." } do %>
            <i class="fas fa-rotate"></i> Ré-analyser
          <% end %>
        </div>
      </div>
      <div class="resume-content" data-text-annotation-target="content" data-action="mouseup->text-annotation#handleSelection">
        <%= sanitize(@lecture.resume, tags: %w[h3 h4 p ul ol li strong em br]) %>
      </div>

      <!-- Notes Section (integrated at the end) -->
      <div class="notes-section">
        <div class="notes-section-header">
          <div class="notes-section-title">
            <i class="fas fa-sticky-note"></i>
            <span>Mes notes</span>
            <span class="notes-count"><%= @lecture.notes.count %></span>
          </div>
          <button type="button" class="btn-add-note" data-bs-toggle="collapse" data-bs-target="#newNoteForm">
            <i class="fas fa-plus"></i> Nouvelle note
          </button>
        </div>

        <!-- New note form (collapsed by default) -->
        <div class="collapse" id="newNoteForm">
          <div class="new-note-form-container">
            <%= form_with url: lecture_notes_path(@lecture), method: :post, data: { turbo_stream: true }, class: "new-note-form", id: "sidebar-note-form" do %>
              <input type="hidden" name="note[annotation_type]" value="sidebar">
              <textarea name="note[content]" placeholder="Écris ta note ici..." rows="3" required class="note-textarea"></textarea>
              <div class="new-note-actions">
                <button type="button" class="btn-cancel-note" data-bs-toggle="collapse" data-bs-target="#newNoteForm">Annuler</button>
                <button type="submit" class="btn-save-note">
                  <i class="fas fa-check"></i> Enregistrer
                </button>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Notes list -->
        <div class="notes-list-integrated" id="notes-list">
          <% if inline_annotations.any? %>
            <div class="notes-group">
              <div class="notes-group-title">
                <i class="fas fa-highlighter"></i> Annotations (<%= inline_annotations.count %>)
              </div>
              <% inline_annotations.each do |annotation| %>
                <%= turbo_frame_tag dom_id(annotation) do %>
                  <div class="note-item annotation-item">
                    <div class="note-item-quote">"<%= truncate(annotation.selected_text, length: 60) %>"</div>
                    <div class="note-item-content"><%= annotation.content %></div>
                    <%= button_to note_path(annotation), method: :delete, data: { turbo_confirm: "Supprimer cette annotation ?" }, class: "btn-delete-note-item" do %>
                      <i class="fas fa-times"></i>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% end %>

          <% if sidebar_notes.any? %>
            <div class="notes-group">
              <div class="notes-group-title">
                <i class="fas fa-pen"></i> Notes (<%= sidebar_notes.count %>)
              </div>
              <% sidebar_notes.each do |note| %>
                <%= turbo_frame_tag dom_id(note) do %>
                  <div class="note-item">
                    <div class="note-item-content"><%= note.content %></div>
                    <%= button_to note_path(note), method: :delete, data: { turbo_confirm: "Supprimer cette note ?" }, class: "btn-delete-note-item" do %>
                      <i class="fas fa-times"></i>
                    <% end %>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% end %>

          <% if @lecture.notes.empty? %>
            <div class="notes-empty">
              <i class="fas fa-sticky-note"></i>
              <p>Aucune note pour ce cours</p>
              <small>Sélectionne du texte pour annoter ou clique sur "Nouvelle note"</small>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Annotation popup -->
      <div class="annotation-popup hidden" data-text-annotation-target="popup">
        <%= form_with url: lecture_notes_path(@lecture), method: :post, data: { turbo_stream: true, action: "turbo:submit-end->text-annotation#onSubmitSuccess" } do %>
          <div class="annotation-popup-header">
            <i class="fas fa-highlighter"></i>
            <span>Ajouter une annotation</span>
          </div>
          <input type="hidden" name="note[selected_text]" value="" data-text-annotation-target="selectedTextInput">
          <input type="hidden" name="note[text_start]" value="" data-text-annotation-target="textStartInput">
          <input type="hidden" name="note[text_end]" value="" data-text-annotation-target="textEndInput">
          <input type="hidden" name="note[annotation_type]" value="inline">
          <textarea name="note[content]" placeholder="Votre note..." rows="2" required data-text-annotation-target="noteInput"></textarea>
          <div class="annotation-popup-actions">
            <button type="button" class="btn-cancel-annotation" data-action="click->text-annotation#closePopup">Annuler</button>
            <button type="submit" class="btn-save-annotation">
              <i class="fas fa-check"></i> Enregistrer
            </button>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%= turbo_stream_from @lecture %>

  <div class="row g-4">
    <!-- Left Column: Chat IA -->
    <div class="col-lg-6">
      <div class="assistant-ia-card" data-controller="chat">
        <div class="assistant-header">
          <div class="assistant-icon"><i class="fas fa-robot"></i></div>
          <div class="assistant-title">
            <h3>Assistant IA</h3>
            <p>Pose tes questions sur le cours</p>
          </div>
        </div>

        <div id="chat-messages" class="chat-messages-container" data-chat-target="messages">
          <% if @lecture.messages.any? %>
            <% @lecture.messages.order(:created_at).each do |message| %>
              <%= render partial: "messages/message", locals: { message: message } %>
            <% end %>
          <% else %>
            <div id="empty-chat-placeholder" class="empty-chat">
              <div class="empty-icon"><i class="far fa-comment-dots"></i></div>
              <p>Commence la conversation avec l'assistant IA</p>
            </div>
          <% end %>
        </div>

        <% unless current_user.pro? %>
          <div class="message-limit-info">
            <%= current_user.messages_remaining %> messages restants au total
            <% unless current_user.can_send_message? %>
              &mdash; <%= link_to "Passer à Pro", pricing_path %>
            <% end %>
          </div>
        <% end %>

        <%= form_with model: [:lecture, Message.new], url: lecture_messages_path(@lecture), class: "chat-input-form", data: { turbo_stream: true, chat_target: "form", action: "turbo:submit-end->chat#resetForm" } do |f| %>
          <%= f.text_area :content, placeholder: "Tape ta question ici...", rows: 2, required: true, data: { chat_target: "input" } %>
          <%= f.submit "Envoyer", class: "submit-button" %>
        <% end %>
      </div>
    </div>

    <!-- Right Column: Flashcards & Quizz -->
    <div class="col-lg-6">
      <div class="row g-3">
        <!-- Flashcards Section (Top 50%) -->
        <div class="col-12" id="flashcards-section">
          <div class="flashcards-card">
            <div class="flashcards-header">
              <div class="flashcards-icon"><i class="fas fa-layer-group"></i></div>
              <div class="flashcards-title">
                <h3>Flashcards</h3>
                <p>Révise tes connaissances</p>
              </div>
              <button type="button" data-bs-toggle="modal" data-bs-target="#generateFlashcardsModal" class="btn-generate-flashcards">
                <i class="fas fa-wand-magic-sparkles"></i> Générer avec IA
              </button>
            </div>

            <% if @lecture.flashcards.any? %>
              <div class="flashcards-list">
                <% @lecture.flashcards.each do |flashcard| %>
                  <%
                    completion = current_user.flashcard_completions.find_by(flashcard: flashcard)
                    progress = completion ? completion.status.to_i : 0
                    questions = JSON.parse(flashcard.content)
                    total = questions.count
                    percentage = total > 0 ? (progress.to_f / total * 100).round : 0
                  %>
                  <div class="flashcard-item">
                    <div class="progress-bar" style="width: <%= percentage %>%;"></div>

                    <div class="flashcard-content">
                      <div class="flashcard-info">
                        <a href="<%= flashcard_path(flashcard) %>" class="flashcard-link">
                          Flashcard #<%= flashcard.id %>
                        </a>
                        <div class="flashcard-stats">
                          <span><%= total %> questions</span>
                          <span class="stat-separator">•</span>
                          <span><%= progress %> complétées</span>
                        </div>
                      </div>

                      <div class="flashcard-actions">
                        <div class="progress-circle">
                          <svg width="70" height="70">
                            <circle cx="35" cy="35" r="30" fill="none" stroke="#E3E2DE" stroke-width="6"/>
                            <circle cx="35" cy="35" r="30" fill="none" stroke="<%= percentage == 100 ? '#28a745' : '#1351AA' %>" stroke-width="6" stroke-dasharray="<%= 2 * Math::PI * 30 %>" stroke-dashoffset="<%= 2 * Math::PI * 30 * (1 - percentage / 100.0) %>" stroke-linecap="round"/>
                          </svg>
                          <div class="progress-text" style="color: <%= percentage == 100 ? '#28a745' : '#1351AA' %>;">
                            <%= percentage %>%
                          </div>
                        </div>

                        <%= button_to flashcard_path(flashcard), method: :delete, data: { turbo: false }, form: { data: { turbo: false } }, onclick: "return confirm('Supprimer cette flashcard ?')", class: "btn-delete-flashcard" do %>
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path stroke-dasharray="24" stroke-dashoffset="24" d="M12 20h5c0.5 0 1 -0.5 1 -1v-14M12 20h-5c-0.5 0 -1 -0.5 -1 -1v-14"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.4s" values="24;0"/></path><path stroke-dasharray="20" stroke-dashoffset="20" d="M4 5h16"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.4s" dur="0.2s" values="20;0"/></path><path stroke-dasharray="8" stroke-dashoffset="8" d="M10 4h4M10 9v7M14 9v7"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.6s" dur="0.2s" values="8;0"/></path></g></svg>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="empty-flashcards">
                <div class="empty-icon"><i class="fas fa-layer-group"></i></div>
                <p>Aucune flashcard pour ce cours</p>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Quiz Section (Below Flashcards) -->
        <div class="col-12" id="quiz-section">
          <div class="flashcards-card">
            <div class="flashcards-header">
              <div class="flashcards-icon"><i class="fas fa-brain"></i></div>
              <div class="flashcards-title">
                <h3>Quiz</h3>
                <p>Teste tes connaissances</p>
              </div>
              <button type="button" data-bs-toggle="modal" data-bs-target="#generateQuizModal" class="btn-generate-flashcards">
                <i class="fas fa-wand-magic-sparkles"></i> Générer un quiz
              </button>
            </div>

            <% if @lecture.quizzes.any? %>
              <div class="flashcards-list">
                <% @lecture.quizzes.each do |quiz| %>
                  <%
                    best_attempt = quiz.attempts.where(user: current_user, done: true).order(score: :desc).first
                    total = quiz.questions.count
                    best_score = best_attempt&.score || 0
                    percentage = total > 0 ? (best_score.to_f / total * 100).round : 0
                  %>
                  <div class="flashcard-item">
                    <div class="progress-bar" style="width: <%= percentage %>%;"></div>
                    <div class="flashcard-content">
                      <div class="flashcard-info">
                        <a href="<%= quiz_path(quiz) %>" class="flashcard-link">
                          <%= quiz.title %>
                        </a>
                        <div class="flashcard-stats">
                          <span><%= total %> questions</span>
                          <span class="stat-separator">•</span>
                          <span>Niveau <%= quiz.level %></span>
                          <% if best_attempt %>
                            <span class="stat-separator">•</span>
                            <span>Meilleur: <%= best_score %>/<%= total %></span>
                          <% end %>
                        </div>
                      </div>
                      <div class="flashcard-actions">
                        <div class="progress-circle">
                          <svg width="70" height="70">
                            <circle cx="35" cy="35" r="30" fill="none" stroke="#E3E2DE" stroke-width="6"/>
                            <circle cx="35" cy="35" r="30" fill="none" stroke="<%= percentage == 100 ? '#28a745' : '#1351AA' %>" stroke-width="6" stroke-dasharray="<%= 2 * Math::PI * 30 %>" stroke-dashoffset="<%= 2 * Math::PI * 30 * (1 - percentage / 100.0) %>" stroke-linecap="round"/>
                          </svg>
                          <div class="progress-text" style="color: <%= percentage == 100 ? '#28a745' : '#1351AA' %>;">
                            <%= percentage %>%
                          </div>
                        </div>

                        <%= button_to quiz_path(quiz), method: :delete, data: { turbo: false }, form: { data: { turbo: false } }, onclick: "return confirm('Supprimer ce quiz ?')", class: "btn-delete-flashcard" do %>
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path stroke-dasharray="24" stroke-dashoffset="24" d="M12 20h5c0.5 0 1 -0.5 1 -1v-14M12 20h-5c-0.5 0 -1 -0.5 -1 -1v-14"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.4s" values="24;0"/></path><path stroke-dasharray="20" stroke-dashoffset="20" d="M4 5h16"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.4s" dur="0.2s" values="20;0"/></path><path stroke-dasharray="8" stroke-dashoffset="8" d="M10 4h4M10 9v7M14 9v7"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.6s" dur="0.2s" values="8;0"/></path></g></svg>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% else %>
              <div class="empty-flashcards">
                <div class="empty-icon"><i class="fas fa-brain"></i></div>
                <p>Aucun quiz pour ce cours</p>
              </div>
            <% end %>
          </div>
        </div>

<!-- Modal pour générer un quiz -->
<div class="modal fade modal-generate-flashcards" id="generateQuizModal" tabindex="-1" aria-labelledby="generateQuizModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h5 class="modal-title"><i class="fas fa-brain"></i> Générer un quiz</h5>
          <p class="modal-subtitle">Avec l'intelligence artificielle</p>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="modal-icon" style="text-align: center;"><i class="fas fa-microchip"></i></div>
        <p style="text-align: center;">L'IA va générer automatiquement <strong>10 questions</strong> basées sur la catégorie <strong><%= @lecture.category.title %></strong>.</p>
        <%= simple_form_for Quiz.new, url: quizzes_path, html: { data: { controller: "quiz-loading", action: "submit->quiz-loading#submit", turbo: false } } do |f| %>
          <%= f.hidden_field :category_id, value: @lecture.category.id %>
          <%= f.hidden_field :lecture_id, value: @lecture.id %>
          <%= f.hidden_field :status, value: "public" %>
          <%= hidden_field_tag :redirect_to, lecture_path(@lecture, anchor: "quiz-section") %>
          <%= f.input :title, label: "Titre du quiz", input_html: { value: "Quiz - #{@lecture.title}" }, placeholder: "Ex: Quiz #{@lecture.title}", required: true, wrapper_html: { class: "form-group-modal" } %>
          <%= f.input :level, as: :radio_buttons, collection: (1..5).map { |n| ["Niveau #{n}", n] }, label: "Niveau de difficulté", required: true, wrapper_html: { class: "form-group-modal level-radio-group" } %>
          <div class="modal-footer">
            <button type="button" data-bs-dismiss="modal" class="btn-modal-cancel">Annuler</button>
            <%= f.submit "Générer le quiz", class: "btn-modal-submit" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Modal pour générer les flashcards -->
<div class="modal fade modal-generate-flashcards" id="generateFlashcardsModal" tabindex="-1" aria-labelledby="generateFlashcardsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <div>
          <h5 class="modal-title"><i class="fas fa-wand-magic-sparkles"></i> Générer des flashcards</h5>
          <p class="modal-subtitle">Avec l'intelligence artificielle</p>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center">
        <div class="modal-icon"><i class="fas fa-microchip"></i></div>
        <p>L'IA va générer automatiquement <strong>10 questions</strong> basées sur le contenu de ce cours.</p>
        <p class="modal-note">Ces flashcards te permettront de réviser régulièrement.</p>
      </div>
      <div class="modal-footer" >
        <button type="button" data-bs-dismiss="modal" class="btn-modal-cancel">Annuler</button>
        <%= form_with url: lecture_flashcards_path(@lecture), data: { controller: "flashcard-loading", action: "submit->flashcard-loading#submit", turbo: false }, method: :post, local: true, style: "display: inline;" do |f| %>
          <%= f.submit "Générer maintenant", class: "btn-modal-submit" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

      </div>
    </div>
  </div>
</div>
