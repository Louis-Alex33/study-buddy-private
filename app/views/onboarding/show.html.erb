<% content_for(:title, "Bienvenue sur Studigo") %>

<div class="onboarding-page">
  <div class="onboarding-container">
    <div class="onboarding-header">
      <div class="onboarding-logo">S</div>
      <h1>🎉 Bienvenue, <%= current_user.display_name %> !</h1>
      <p>Ajoute ton premier cours pour générer tes supports de révision.</p>
    </div>

    <div class="onboarding-bullets">
      <div class="onboarding-bullet">📄 <strong>PDF, image ou texte</strong> — importez n'importe quel format</div>
      <div class="onboarding-bullet">⚡ <strong>Flashcards auto</strong> — générées en un clic par l'IA</div>
      <div class="onboarding-bullet">🤖 <strong>Quiz auto</strong> — testez-vous et défiez vos amis</div>
    </div>

    <div class="onboarding-actions">
      <%= link_to complete_onboarding_path, data: { turbo_method: :patch }, class: "onboarding-btn-start" do %>
        <span>📂 Importer un cours</span>
        <i class="fas fa-arrow-right"></i>
      <% end %>
    </div>
  </div>
</div>
