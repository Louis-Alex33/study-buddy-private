<% content_for(:title, "Classement") %>
<% content_for(:breadcrumbs) do %>
  <li class="breadcrumbs-item">Classement</li>
<% end %>

<div class="leaderboard-page">
  <div class="leaderboard-header">
    <div class="leaderboard-header-content">
      <h1><i class="fas fa-trophy"></i> Classement général</h1>
      <p>Ta position : <strong>#<%= @current_user_rank %></strong> avec <strong><%= current_user.points %></strong> points</p>
    </div>
  </div>

  <div class="leaderboard-section">
    <h2><i class="fas fa-star"></i> Top joueurs par points</h2>
    <div class="leaderboard-list">
      <% @top_by_points.each_with_index do |user, index| %>
        <div class="leaderboard-item <%= 'leaderboard-current' if user == current_user %>">
          <div class="leaderboard-rank">
            <% if index < 3 %>
              <span class="leaderboard-medal leaderboard-medal-<%= index + 1 %>">
                <i class="fas fa-medal"></i>
              </span>
            <% else %>
              <span class="leaderboard-position">#<%= index + 1 %></span>
            <% end %>
          </div>
          <div class="leaderboard-user">
            <span class="leaderboard-name"><%= user.display_name %></span>
            <% if user.pro? %>
              <span class="leaderboard-pro-badge">PRO</span>
            <% end %>
          </div>
          <div class="leaderboard-score"><%= user.points %> pts</div>
        </div>
      <% end %>
    </div>
  </div>

  <% if @top_by_leagues.any? %>
    <div class="leaderboard-section">
      <h2><i class="fas fa-chess-queen"></i> Top joueurs par ligue</h2>
      <div class="leaderboard-list">
        <% @top_by_leagues.each_with_index do |league, index| %>
          <div class="leaderboard-item <%= 'leaderboard-current' if league.user == current_user %>">
            <div class="leaderboard-rank">
              <% if index < 3 %>
                <span class="leaderboard-medal leaderboard-medal-<%= index + 1 %>">
                  <i class="fas fa-medal"></i>
                </span>
              <% else %>
                <span class="leaderboard-position">#<%= index + 1 %></span>
              <% end %>
            </div>
            <div class="leaderboard-user">
              <span class="leaderboard-name"><%= league.user.display_name %></span>
              <span class="leaderboard-league-rank" style="color: <%= league.rank_color %>"><%= league.display_name %></span>
            </div>
            <div class="leaderboard-score"><%= league.points %> LP</div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="leaderboard-back">
    <%= link_to root_path, class: "btn-back-home" do %>
      <i class="fas fa-arrow-left"></i> Retour à l'accueil
    <% end %>
  </div>
</div>
