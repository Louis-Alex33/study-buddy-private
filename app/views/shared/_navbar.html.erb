<nav class="navbar-studigo" data-controller="navbar" role="navigation" aria-label="Navigation principale">
  <div class="navbar-container">
    <%= link_to root_path, class: "navbar-brand" do %>
      <div class="navbar-logo">S</div>
      <h1 class="navbar-title">Studigo</h1>
      <span class="badge-beta">Bêta</span>
    <% end %>
    <button class="navbar-burger" data-navbar-target="burger" data-action="click->navbar#toggle" aria-label="Menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
    <div class="navbar-links" data-navbar-target="links">
      <% if user_signed_in? %>
        <%= link_to "Mes cours", lectures_path, class: "navbar-link #{'active' if current_page?(lectures_path)}", data: { action: "click->navbar#closeMenu" } %>
        <%= link_to "Mes Quiz", quizzes_path, class: "navbar-link #{'active' if current_page?(quizzes_path)}", data: { action: "click->navbar#closeMenu" } %>
        <%= link_to multiplayer_path, class: "navbar-link #{'active' if current_page?(multiplayer_path)}", data: { action: "click->navbar#closeMenu" } do %>
          Multijoueur
          <% unless current_user.pro? %>
            <span class="navbar-pro-badge navbar-pro-badge--small">PRO</span>
          <% end %>
        <% end %>
        <%= link_to leaderboard_path, class: "navbar-link #{'active' if current_page?(leaderboard_path)}", title: "Classement", aria: { label: "Classement" }, data: { action: "click->navbar#closeMenu" } do %>
          <i class="fas fa-trophy" aria-hidden="true"></i>
        <% end %>
        <%= link_to stats_path, class: "navbar-link #{'active' if current_page?(stats_path)}", title: "Statistiques", aria: { label: "Statistiques" }, data: { action: "click->navbar#closeMenu" } do %>
          <i class="fas fa-chart-bar" aria-hidden="true"></i>
        <% end %>
        <%= link_to search_path, class: "navbar-link #{'active' if current_page?(search_path)}", title: "Recherche", aria: { label: "Recherche" }, data: { action: "click->navbar#closeMenu" } do %>
          <i class="fas fa-search" aria-hidden="true"></i>
        <% end %>
        <button type="button" class="theme-toggle-pill" data-action="click->dark-mode#toggle" title="Changer de thème" aria-label="Changer de thème">
          <div class="theme-toggle-track">
            <i class="fas fa-sun theme-toggle-icon theme-toggle-icon--sun" aria-hidden="true"></i>
            <i class="fas fa-moon theme-toggle-icon theme-toggle-icon--moon" aria-hidden="true"></i>
            <div class="theme-toggle-thumb"></div>
          </div>
        </button>
        <div class="navbar-divider"></div>
        <div class="navbar-user-info">
          <span class="navbar-user-email"><%= current_user.display_name %></span>
          <% if current_user.pro? %>
            <%= link_to subscription_manage_path, class: "navbar-pro-badge-link" do %>
              <span class="navbar-pro-badge">PRO</span>
            <% end %>
          <% else %>
            <%= link_to "Passer à Pro", pricing_path, class: "navbar-upgrade-link" %>
          <% end %>
        </div>
        <%= link_to edit_user_registration_path, class: "navbar-link-account", title: "Mon compte", aria: { label: "Mon compte" }, data: { action: "click->navbar#closeMenu" } do %>
          <i class="fas fa-user-cog" aria-hidden="true"></i>
        <% end %>
        <%= link_to subscription_manage_path, class: "navbar-link-account", title: "Mon abonnement", aria: { label: "Mon abonnement" }, data: { action: "click->navbar#closeMenu" } do %>
          <i class="fas fa-cog" aria-hidden="true"></i>
        <% end %>
        <% if current_user.admin? %>
          <%= link_to admin_dashboard_path, class: "navbar-link-account", title: "Admin", aria: { label: "Administration" }, data: { action: "click->navbar#closeMenu" } do %>
            <i class="fas fa-shield-alt" aria-hidden="true"></i>
          <% end %>
        <% end %>
        <%= link_to "Déconnexion", destroy_user_session_path, data: { turbo_method: :delete, action: "click->navbar#closeMenu" }, class: "navbar-btn" %>
      <% else %>
        <a href="/#features" class="navbar-link" data-action="click->navbar#closeMenu">Produit</a>
        <%= link_to "Tarifs", pricing_path, class: "navbar-link #{'active' if current_page?(pricing_path)}", data: { action: "click->navbar#closeMenu" } %>
        <button type="button" class="theme-toggle-pill" data-action="click->dark-mode#toggle" title="Changer de thème" aria-label="Changer de thème">
          <div class="theme-toggle-track">
            <i class="fas fa-sun theme-toggle-icon theme-toggle-icon--sun" aria-hidden="true"></i>
            <i class="fas fa-moon theme-toggle-icon theme-toggle-icon--moon" aria-hidden="true"></i>
            <div class="theme-toggle-thumb"></div>
          </div>
        </button>
        <%= link_to "Connexion", new_user_session_path, class: "navbar-btn", data: { action: "click->navbar#closeMenu" } %>
        <%= link_to "Créer un compte", new_user_registration_path, class: "navbar-btn-primary", data: { action: "click->navbar#closeMenu" } %>
      <% end %>
    </div>
  </div>
</nav>
