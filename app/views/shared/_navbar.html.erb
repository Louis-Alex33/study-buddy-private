<nav class="navbar-studigo">
  <div class="navbar-container">
    <%= link_to root_path, class: "navbar-brand" do %>
      <div class="navbar-logo">S</div>
      <h1 class="navbar-title">Studigo</h1>
    <% end %>
    <div class="navbar-links">
      <% if user_signed_in? %>
        <%= link_to "Mes cours", lectures_path, class: "navbar-link #{'active' if current_page?(lectures_path)}" %>
        <%= link_to "Mes Quiz", quizzes_path, class: "navbar-link #{'active' if current_page?(quizzes_path)}" %>
        <%= link_to multiplayer_path, class: "navbar-link #{'active' if current_page?(multiplayer_path)}" do %>
          Multijoueur
          <% unless current_user.pro? %>
            <span class="navbar-pro-badge navbar-pro-badge--small">PRO</span>
          <% end %>
        <% end %>
        <%= link_to leaderboard_path, class: "navbar-link #{'active' if current_page?(leaderboard_path)}", title: "Classement" do %>
          <i class="fas fa-trophy"></i>
        <% end %>
        <%= link_to stats_path, class: "navbar-link #{'active' if current_page?(stats_path)}", title: "Statistiques" do %>
          <i class="fas fa-chart-bar"></i>
        <% end %>
        <%= link_to search_path, class: "navbar-link #{'active' if current_page?(search_path)}", title: "Recherche" do %>
          <i class="fas fa-search"></i>
        <% end %>
        <div class="theme-toggle-pill" data-action="click->dark-mode#toggle" title="Changer de thème">
          <div class="theme-toggle-track">
            <i class="fas fa-sun theme-toggle-icon theme-toggle-icon--sun"></i>
            <i class="fas fa-moon theme-toggle-icon theme-toggle-icon--moon"></i>
            <div class="theme-toggle-thumb"></div>
          </div>
        </div>
        <div class="navbar-divider"></div>
        <div class="navbar-user-info">
          <span class="navbar-user-email"><%= current_user.display_name %></span>
          <% if current_user.pro? %>
            <%= link_to subscription_manage_path, class: "navbar-pro-badge-link" do %>
              <span class="navbar-pro-badge">PRO</span>
            <% end %>
          <% else %>
            <%= link_to "Passer à Pro", pricing_path, class: "navbar-upgrade-link" %>
          <% end %>
        </div>
        <%= link_to subscription_manage_path, class: "navbar-link-account", title: "Mon abonnement" do %>
          <i class="fas fa-cog"></i>
        <% end %>
        <% if current_user.admin? %>
          <%= link_to admin_dashboard_path, class: "navbar-link-account", title: "Admin" do %>
            <i class="fas fa-shield-alt"></i>
          <% end %>
        <% end %>
        <%= link_to "Déconnexion", destroy_user_session_path, data: { turbo_method: :delete }, class: "navbar-btn" %>
      <% else %>
        <div class="theme-toggle-pill" data-action="click->dark-mode#toggle" title="Changer de thème">
          <div class="theme-toggle-track">
            <i class="fas fa-sun theme-toggle-icon theme-toggle-icon--sun"></i>
            <i class="fas fa-moon theme-toggle-icon theme-toggle-icon--moon"></i>
            <div class="theme-toggle-thumb"></div>
          </div>
        </div>
        <%= link_to "Connexion", new_user_session_path, class: "navbar-btn" %>
        <%= link_to "Inscription", new_user_registration_path, class: "navbar-btn-primary" %>
      <% end %>
    </div>
  </div>
</nav>
