<% unless current_user.pro? %>
  <div class="pro-upgrade-prompt">
    <div class="pro-upgrade-icon"><i class="fas fa-crown"></i></div>
    <div class="pro-upgrade-content">
      <h3>Passez à Studigo Pro</h3>
      <p>Débloquez un accès illimité à tous les cours, quiz, flashcards et au mode multijoueur.</p>
    </div>
    <%= link_to pricing_path, class: "pro-upgrade-btn" do %>
      Découvrir Pro <i class="fas fa-arrow-right"></i>
    <% end %>
  </div>
<% end %>
